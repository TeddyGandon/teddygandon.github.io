  "version": "0.2",
  "language": "en",
  "files": [
    "src/content/articles/*.md",
    "src/views/*.vue",
    "src/components/*.vue",
    "src/data/{experience,skills,certifications,projects}.js",
    "index.html",
    "public/404.html"
